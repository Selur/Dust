#include <winver.h>
#include "version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DUST_VERSION_MAJOR, DUST_VERSION_MINOR, DUST_VERSION_PATCH, 0
PRODUCTVERSION DUST_VERSION_MAJOR, DUST_VERSION_MINOR, DUST_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Yuri Pronkin, Selur"
      VALUE "FileDescription", "Dust: limit-clipping spatiotemporal denoiser for AviSynth+ and VapourSynth"
      VALUE "FileVersion", DUST_VERSION
      VALUE "InternalName", "Dust"
      VALUE "LegalCopyright", "(c) 2026 Yuri Pronkin (DustPort), Selur (Dust), MIT"
      VALUE "OriginalFilename", "Dust.dll"
      VALUE "ProductName", "Dust"
      VALUE "ProductVersion", DUST_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
